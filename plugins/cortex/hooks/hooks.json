{
  "description": "Cortex task context loading and batch evidence checkpoints.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/evidence.py\" hook",
            "commandWindows": "python \"${PLUGIN_ROOT}/scripts/evidence.py\" hook",
            "timeout": 5,
            "statusMessage": "Checking Cortex evidence"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/context.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/scripts/context.py\"",
            "timeout": 5,
            "statusMessage": "Loading Cortex task context",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/evidence.py\" hook",
            "commandWindows": "python \"${PLUGIN_ROOT}/scripts/evidence.py\" hook",
            "timeout": 5,
            "statusMessage": "Checking Cortex evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/evidence.py\" hook",
            "commandWindows": "python \"${PLUGIN_ROOT}/scripts/evidence.py\" hook",
            "timeout": 5,
            "statusMessage": "Checking Cortex evidence"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/context.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/scripts/context.py\"",
            "timeout": 5,
            "statusMessage": "Loading Cortex task context",
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
